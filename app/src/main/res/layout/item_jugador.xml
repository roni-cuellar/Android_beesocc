<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical" android:background="@drawable/bg_card" android:layout_marginBottom="10dp">
    <TextView android:id="@+id/dorsalJugador" android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:background="@drawable/bg_pale" android:text="10" android:textStyle="bold" android:textSize="22sp" android:textColor="@color/verde_oscuro" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp">
        <TextView android:id="@+id/nombreJugador" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Carlos Pérez" android:textColor="@color/texto" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/posicionJugador" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Delantero" android:textColor="@color/gris" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Titulo" android:text="Crear liga" />
            <Space android:layout_width="1dp" android:layout_height="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Completa los datos de tu campeonato." />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/texto" android:text="Nombre" android:textStyle="bold" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <EditText android:id="@+id/campoNombreLiga" style="@style/Campo" android:hint="Ej. Liga BetPlay" android:inputType="text" android:singleLine="true" />
                <Space android:layout_width="1dp" android:layout_height="18dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/texto" android:text="Descripción (opcional)" android:textStyle="bold" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <EditText android:id="@+id/campoDescripcion" style="@style/Campo" android:hint="Describe tu campeonato" android:inputType="text" android:singleLine="true" />
                <Space android:layout_width="1dp" android:layout_height="18dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/texto" android:text="Temporada" android:textStyle="bold" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <EditText android:id="@+id/campoTemporada" style="@style/Campo" android:hint="Ej. 2026" android:inputType="text" android:singleLine="true" />
                <Space android:layout_width="1dp" android:layout_height="18dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/texto" android:text="Formato" android:textStyle="bold" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="13dp" android:background="@drawable/bg_card">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/verde_oscuro" android:text="Todos contra todos" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="23dp" />
                <Button android:id="@+id/btnGuardarLiga" style="@style/BotonPrimario" android:layout_width="match_parent" android:text="Guardar liga" />
                <Space android:layout_width="1dp" android:layout_height="10dp" />
                <Button android:id="@+id/btnCancelar" style="@style/BotonSecundario" android:layout_width="match_parent" android:text="Cancelar" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Titulo" android:text="Mis ligas" />
            <Space android:layout_width="1dp" android:layout_height="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Organiza tus campeonatos y sigue cada jornada." />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <Button android:id="@+id/btnCrearLiga" style="@style/BotonPrimario" android:layout_width="match_parent" android:text="Crear liga" />
            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_pale" android:orientation="vertical" android:padding="14dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="160dp" android:src="@drawable/ilustracion_trofeo" android:scaleType="fitCenter" android:contentDescription="Ilustración de BEESOCC" />
                    <Space android:layout_width="1dp" android:layout_height="6dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/verde_oscuro" android:text="PLANIFICACIÓN" android:textStyle="bold" />
                </LinearLayout>
                <Space android:layout_width="1dp" android:layout_height="17dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/gris" android:text="TEMPORADA" android:textStyle="bold" />
                <Space android:layout_width="1dp" android:layout_height="5dp" />
                <TextView android:id="@+id/textoTemporada" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/verde_oscuro" android:text="2025" />
                <Space android:layout_width="1dp" android:layout_height="7dp" />
                <TextView android:id="@+id/textoLiga" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Seccion" android:text="Liga BetPlay" />
                <Space android:layout_width="1dp" android:layout_height="8dp" />
                <TextView android:id="@+id/textoDescripcion" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Campeonato de fútbol" />
                <Space android:layout_width="1dp" android:layout_height="22dp" />
                <Button android:id="@+id/btnAdministrar" style="@style/BotonPrimario" android:layout_width="match_parent" android:text="Administrar" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="14dp" />
            <Button android:id="@+id/btnSalir" style="@style/BotonSecundario" android:layout_width="match_parent" android:text="Salir" />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
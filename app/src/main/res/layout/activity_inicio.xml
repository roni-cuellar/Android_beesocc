            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Organiza tus ligas y temporadas." />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">

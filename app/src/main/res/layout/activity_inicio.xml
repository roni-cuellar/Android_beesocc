            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Seccion" android:text="Equipos y jugadores" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Plantillas, dorsales y posiciones." />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
            <ImageView android:layout_width="match_parent" android:layout_height="130dp" android:src="@drawable/ilustracion_calendario" android:scaleType="fitCenter" android:contentDescription="Ilustración de BEESOCC" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Seccion" android:text="Partidos y calendario" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Todos los encuentros de tu liga." />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
            <ImageView android:layout_width="match_parent" android:layout_height="130dp" android:src="@drawable/ilustracion_estadisticas" android:scaleType="fitCenter" android:contentDescription="Ilustración de BEESOCC" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Seccion" android:text="Estadísticas en tiempo real" />
            <Space android:layout_width="1dp" android:layout_height="6dp" />

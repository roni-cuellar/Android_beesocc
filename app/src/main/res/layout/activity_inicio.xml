            <Space android:layout_width="1dp" android:layout_height="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Menos gestión.&#10;Más fútbol." android:textColor="@color/blanco" android:textSize="34sp" android:textStyle="bold" />
            <Space android:layout_width="1dp" android:layout_height="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Organiza equipos, partidos y resultados en un solo lugar." android:textColor="#D9EDE3" android:textSize="15sp" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <ImageView android:layout_width="match_parent" android:layout_height="234dp" android:src="@drawable/ilustracion_inicio" android:scaleType="fitCenter" android:contentDescription="Ilustración de BEESOCC" />
            <Space android:layout_width="1dp" android:layout_height="18dp" />
            <Button android:id="@+id/btnComenzar" style="@style/BotonSecundario" android:layout_width="match_parent" android:text="Comenzar ahora" />
            <Space android:layout_width="1dp" android:layout_height="10dp" />
            <Button android:id="@+id/btnExplorar" style="@style/BotonSecundario" android:layout_width="match_parent" android:text="Conocer más" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="28dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Seccion" android:text="Todo tu campeonato, en un solo lugar." />
        <Space android:layout_width="1dp" android:layout_height="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">
            <ImageView android:layout_width="match_parent" android:layout_height="130dp" android:src="@drawable/ilustracion_trofeo" android:scaleType="fitCenter" android:contentDescription="Ilustración de BEESOCC" />

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo" android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Titulo" android:text="Tabla de posiciones" />
            <Space android:layout_width="1dp" android:layout_height="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="La clasificación de tu campeonato." />
            <Space android:layout_width="1dp" android:layout_height="24dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Seccion" android:text="Clasificación general" />
                <Space android:layout_width="1dp" android:layout_height="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Subtitulo" android:text="Solo cuentan los partidos finalizados." />
                <Space android:layout_width="1dp" android:layout_height="20dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                    <TextView android:layout_width="27dp" android:layout_height="wrap_content" android:text="#" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Equipo" android:textSize="12sp" />
                    <TextView android:layout_width="33dp" android:layout_height="wrap_content" android:text="PJ" android:textSize="12sp" />
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:text="DG" android:textSize="12sp" />
                    <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:text="PTS" android:textStyle="bold" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/listaTabla" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>